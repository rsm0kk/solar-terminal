# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 절대 git 에 커밋하지 않습니다.
#   copy .env.example .env       (Windows)
#   cp .env.example .env         (macOS/Linux)
#
# 키가 없어도 프로젝트는 정상 동작합니다.
# 해당 소스만 '데이터 상태' 탭에 "API 미설정" 으로 표시되고 나머지는 그대로 수집됩니다.

# ── 필수는 아니지만 있으면 크게 좋아지는 것 ─────────────────────
# 미국 태양광 발전량·설비용량. 무료 즉시 발급.
#   https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# 공공데이터포털 서비스키. SMP·REC 수집에 사용.
#   주의: 키 발급만으로는 안 되고 "한국전력거래소 계통한계가격(SMP)" 등
#   개별 API 에 '활용신청'을 해야 동작합니다. 신청 승인 후 같은 키가 그대로 먹습니다.
#   https://www.data.go.kr
DATA_GO_KR_SERVICE_KEY=

# ── 이미 동작 중 (기존 키 재사용 가능) ──────────────────────────
# 공시·분기재무. https://opendart.fss.or.kr
DART_API_KEY=

# 환율 등 거시지표. https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ── 선택 (없어도 됨) ───────────────────────────────────────────
# 주가는 공개 시세로 이미 수집되므로 아래는 없어도 됩니다.
KRX_API_KEY=
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=

# 뉴스 탭을 쓸 경우. https://developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NEWS_API_KEY=
